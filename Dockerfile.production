FROM node:22-bookworm

# Set the working directory inside the container
WORKDIR /app

# Get the environment variables
ARG NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN
ARG NEXT_PUBLIC_CONTENTFUL_SPACE_ID
ARG NEXT_PUBLIC_CONTENTFUL_PREVIEW
ARG NEXT_PUBLIC_CONTENTFUL_PREVIEW_TOKEN
ARG NEXT_PUBLIC_HOST_URL

ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
# Set the environment variables
ENV NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=$NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN
ENV NEXT_PUBLIC_CONTENTFUL_SPACE_ID=$NEXT_PUBLIC_CONTENTFUL_SPACE_ID
ENV NEXT_PUBLIC_CONTENTFUL_PREVIEW=$NEXT_PUBLIC_CONTENTFUL_PREVIEW
ENV NEXT_PUBLIC_CONTENTFUL_PREVIEW_TOKEN=$NEXT_PUBLIC_CONTENTFUL_PREVIEW_TOKEN
ENV NEXT_PUBLIC_HOST_URL=$NEXT_PUBLIC_HOST_URL

ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ENV NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID

COPY package*.json ./

RUN npm install -g npm@11.8.0

# Reduce CI flakes during dependency install (buildx/arm64 often hits network/TLS resets)
ENV NODE_OPTIONS=--dns-result-order=ipv4first \
	NPM_CONFIG_FUND=false \
	NPM_CONFIG_AUDIT=false \
	NPM_CONFIG_FETCH_RETRIES=10 \
	NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
	NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=600000 \
	NPM_CONFIG_FETCH_TIMEOUT=600000

# Install dependencies.
#
# Sem --build-from-source: nada aqui precisa compilar código nativo. O flag e o
# toolchain apt-get (build-essential, cairo, pango, jpeg, gif, rsvg) existiam
# para o pacote `canvas`, que não está mais na árvore de dependências — os
# gráficos do relatório municipal são SVG montado à mão em
# src/services/municipalReportChartRenderer.ts. O flag forçava os pacotes que
# ainda têm binding nativo (sharp, @parcel/watcher) a compilar em vez de baixar
# o binário pronto, e produção e gamma buildam linux/arm64 sob emulação QEMU no
# runner ubuntu-latest, onde essa compilação é ordens de grandeza mais lenta.
RUN npm ci --no-audit --no-fund --loglevel=info

# Copy the rest of the application code
COPY . .

# Expose the port Next.js runs on (default: 3000)
EXPOSE 3000

# Build the Next.js project
RUN npm run build

# Executa o binário do Next como PID 1, sem npm nem shell no meio. Com `npm start`
# o SIGTERM do `docker stop` morria no npm e o next-server ficava órfão segurando
# a porta: medido em >25s sem encerrar, contra 739ms chamando o binário direto.
# É isso que permite ao deploy parar o container antigo de forma graciosa, em vez
# de matá-lo no meio dos requests em andamento.
CMD ["/app/node_modules/.bin/next", "start"]
