{
  "name": "sedes-chatbot",
  "private": true,
  "version": "0.9.0",
  "description": "Protótipo de chatbot do SEDES: ferramentas só de leitura sobre o tabelão, página de chat e servidor MCP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "chat": "tsx src/chat/servidor-chat.ts",
    "tabelao": "cd ../.. && node --conditions=react-server --import tsx tools/sedes-chatbot/src/gee/montar-tabelao.ts",
    "conferir": "tsx src/gee/conferir-com-relatorio.ts",
    "servidor": "tsx src/servidor.ts",
    "consultas": "tsx src/rodar-consultas.ts",
    "guia": "tsx src/conhecimento/gerar-guia.ts",
    "avaliar": "tsx src/avaliar.ts",
    "candidatas": "tsx src/candidatas.ts",
    "testar": "node --import tsx --test src/testes/*.teste.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "firebase-admin": "13.10.0",
    "marked": "18.1.2",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
