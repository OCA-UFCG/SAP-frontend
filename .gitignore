# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/scripts
!/scripts/
/scripts/*
# Scripts usados pelo CI precisam ser versionados, apesar da regra acima.
!/scripts/download-tiles.sh
!/scripts/deploy-container.sh
# Tira o e-mail dos eventos de uso antigos; é um passo do deploy da LGPD
# (docs/telemetria.md), e o teste dele importa o arquivo.
!/scripts/telemetry-remove-personal-data.mjs
# Gerador do GeoJSON de visão geral da AMFE: o artefato em public/data é
# commitado, então a receita para regerá-lo também precisa ser.
!/scripts/build-cities-overview.mjs
# Libera as contas existentes antes do bloqueio de acesso ser ligado. Faz parte
# do procedimento de deploy, não do ambiente de quem desenvolve.
!/scripts/backfill-access-claims.mjs
# Prova que a conta de envio funciona, antes de confiar nela em produção.
!/scripts/send-test-email.mjs
# Gerador da lista de nomes da busca de Territórios: o artefato em public/data
# é commitado e precisa ser regerado quando um asset das camadas for trocado.
!/scripts/build-reference-territories.mjs
# Gerador dos tiles dos territórios, anexados à release `tiles-2025`.
!/scripts/build-territory-tiles.mjs
# Configuração do SEDES na VM de monitoramento, aplicada pelo deploy.sh.
!/scripts/monitoring/
/scripts/monitoring/__pycache__/
# Rotação dos logs do Docker, instalada nas VMs pelo workflow docker-logs.yaml.
!/scripts/docker-logs/
/scripts/gee/
/tmp
mise.toml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static
.vscode/

# Local personal context notes. Do not commit.
/my_contexts/

# Generated Google Drive CSV downloads and transformed Contentful JSON outputs.
/data/contentful-pipeline/

# Generated from published Contentful municipal analysis during build.
/src/data/municipalAvailabilityIndex.json

/BR_Municipios_2025

# Generated/downloaded vector tile artifacts.
/public/tiles/*.mbtiles
!/public/tiles/.gitkeep

Molde_RelatorioAnalitico_SAP_v2_edit.pdf
relatorio_template.docx

data/runtime/
/campos-necessarios-indice-sap.txt

# Worktrees e estado local de agentes
/.claude/
